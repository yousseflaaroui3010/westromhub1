# ============================================================
# FRONTEND env vars (root .env or .env.local)
# ============================================================

# API base URL — only needed when running frontend independently of the proxy.
# With Vite dev server the proxy handles /api automatically; leave this unset.
# VITE_API_BASE_URL=http://localhost:3001
# Public Cloudflare Turnstile site key (also a build ARG in Dockerfile.frontend).
# VITE_TURNSTILE_SITE_KEY=

# ============================================================
# API env vars (api/.env)
# ============================================================

PORT=3001

# SEC-1: CORS — exact frontend domain(s), comma-separated. Never use * in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ----------------------------------------------------------------
# Abuse protection (see docs/SECURITY.md for the deploy order)
# ----------------------------------------------------------------
# Shared with the frontend (nginx) service; /api/* without it is refused.
# INTERNAL_PROXY_TOKEN=
# Cloudflare Turnstile secret: paid AI routes then require a challenge session.
# TURNSTILE_SECRET_KEY=
# >= 32 chars; keeps sessions valid across restarts.
# SESSION_SECRET=
# Shared counters (rate limits, budgets) across replicas/restarts.
# REDIS_URL=redis://default:password@redis.railway.internal:6379
# Max billable AI provider attempts per UTC day (0 = unlimited, local only).
# AI_DAILY_CALL_CAP=400
# AI_MAX_CONCURRENCY=4

# Lead-form gateway (/api/leads/*) in front of the n8n webhooks.
# N8N_LEAD_WEBHOOK_BASE=https://main-production-bf72.up.railway.app/webhook/d043c102d78e
# N8N_GATEWAY_SECRET=        # >= 32 chars; = WGC_GATEWAY_SECRET on n8n main + worker
# LEAD_ALLOWED_ORIGINS=https://wgcassetguide.com,https://westromgroup.com,https://www.westromgroup.com
# LEAD_REQUIRE_TURNSTILE=false   # true only once every embed sends data-turnstile-sitekey
# LEAD_DAILY_SUBMIT_CAP=300
# LEAD_DAILY_GUIDE_EMAIL_CAP=150

# ----------------------------------------------------------------
# PRIMARY AI provider — Google Gemini (handles BOTH text & vision)
# Free tier: ai.google.dev/gemini-api  →  New project → API key
# Recommended: gemini-2.5-flash (fast, generous quota) or gemini-2.5-pro (highest accuracy)
# ----------------------------------------------------------------
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ----------------------------------------------------------------
# TEXT fallback — Groq (OpenAI-compatible, very fast inference)
# Free tier: console.groq.com
# ----------------------------------------------------------------
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# ----------------------------------------------------------------
# VISION fallback — OpenRouter
# Priority: premium model first, then free model as last resort.
# Free tier / pay-as-you-go: openrouter.ai
# ----------------------------------------------------------------
OPENROUTER_API_KEY=
# Premium fallback (same Gemini quality via OpenRouter): $0.15/M input
# OPENROUTER_PREMIUM_MODEL=google/gemini-2.5-flash
# Free fallback (Gemma 4 31B — smaller but free): 
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# ----------------------------------------------------------------
# FUTURE providers (add your own as needed — see api/src/providers/)
# These follow the same OpenAI-compatible pattern as Groq.
# ----------------------------------------------------------------
# MoonShot (Kimi): https://platform.moonshot.cn/
MOONSHOT_API_KEY=
# MOONSHOT_MODEL=moonshot-v1-8k
# Models: moonshot-v1-8k | moonshot-v1-32k | moonshot-v1-128k
