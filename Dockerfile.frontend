# --- Build stage ---
FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# Public Turnstile site key, baked into the bundle. Railway passes service
# variables to declared build ARGs. Empty = no bot challenge in the UI.
ARG VITE_TURNSTILE_SITE_KEY=""
ENV VITE_TURNSTILE_SITE_KEY=$VITE_TURNSTILE_SITE_KEY
RUN npm run build

# --- Runtime stage ---
FROM nginx:1.31-alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
COPY api-proxy.inc.template /etc/nginx/templates/api-proxy.inc.template

# SEC-6: nginx:alpine ships with a built-in nginx user (uid 101).
# nginx master process must start as root to bind port 80 then drops to nginx user.
# We explicitly set ownership so the worker can read the static files.
RUN chown -R nginx:nginx /usr/share/nginx/html && chmod -R 755 /usr/share/nginx/html

# API_UPSTREAM is injected at container start via nginx:alpine's built-in template processor.
# The entrypoint script substitutes only actual env vars — nginx variables ($uri, $host, etc.)
# are NOT env vars and are left intact.
# Local Docker Compose: API_UPSTREAM=http://api:3001  (set in docker-compose.yml)
# Railway:              API_UPSTREAM=http://api.railway.internal:3001  (set in Railway env vars)
ENV API_UPSTREAM=http://api:3001
# Shared secret sent to the API on every proxied request (see nginx template).
# Empty by default so local compose works; set it on BOTH Railway services.
ENV INTERNAL_PROXY_TOKEN=""
# Have the image export NGINX_LOCAL_RESOLVERS from /etc/resolv.conf so nginx
# can re-resolve api.railway.internal at runtime (fixes stale-IP 502s).
ENV NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1
# Railway injects PORT at runtime and overrides this default.
# Docker Compose (no PORT set): falls back to 80.
ENV PORT=80

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
